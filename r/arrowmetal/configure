#!/bin/sh
# Records the absolute path of the in-tree dylib in src/lib_path.h so an installed package can find
# it without ARROWMETAL_LIB. The package installs and loads fine when this finds nothing; the error
# at first use then names both ARROWMETAL_LIB and the relative path that was tried.
set -e
SRC=`pwd`
CAND="$SRC/../../.build/release/libArrowMetalC.dylib"
if [ -f "$CAND" ]; then
  # Resolve ../.. without requiring GNU realpath.
  ABS=`cd "$SRC/../../.build/release" && pwd`/libArrowMetalC.dylib
  echo "arrowmetal: recorded dylib at $ABS"
else
  ABS=""
  echo "arrowmetal: no dylib at $CAND; set ARROWMETAL_LIB at run time"
fi
cat > src/lib_path.h <<EOF
/* Generated by configure. The absolute path of the dylib found next to the package source at
   install time, or the empty string when there was none. */
#define ARROWMETAL_DEFAULT_LIB "$ABS"
EOF
exit 0
